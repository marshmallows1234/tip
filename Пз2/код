#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> numbers1 = { 1, 3, 7, 10 };
    vector<int> numbers2 = { 2, 4, 5, 6 };

    int i = 0; 
    int j = 0; 
    int a = numbers1.size();
    int b = numbers2.size();


    for (int k = 0; k < a + b; k++) {
        if (i < a && (j >= b || numbers1[i] <= numbers2[j])) {
            cout << numbers1[i] << " ";
            ++i;
        } else {
            cout << numbers2[j] << " ";
            ++j;
        }
    }

    return 0;
}

