#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> sp = { 0, 1, 3, 4 };

    int n = sp.size();   
    int sum = 0;

    for (int i = 0; i < n; i++) {
        sum += sp[i];    
    }

    int total = n * (n + 1) / 2; 
    int res = total - sum;       

    cout << res << endl; \
    return 0;
}
